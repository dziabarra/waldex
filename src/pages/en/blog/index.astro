---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { t, localizedUrl } from '@i18n/utils';

const locale = 'en' as const;

const posts = await getCollection('blog', (e) =>
  e.data.locale === 'en' && !e.data.draft,
);
const sorted = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const fmt = new Intl.DateTimeFormat('en-GB', { dateStyle: 'long' });
---

<BaseLayout
  locale={locale}
  title={`${t(locale, 'nav.blog')} — ${t(locale, 'site.name')}`}
  description="Practical articles about designing, building, and shipping trade fair stands."
  canonicalPath="blog"
>
  <section class="container-default pt-12 md:pt-24">
    <h1
      class="text-[length:var(--text-h1)] leading-[var(--leading-h1)] font-semibold tracking-tight max-w-[20ch]"
    >
      {t(locale, 'nav.blog')}
    </h1>
    <p class="mt-6 max-w-[60ch] text-[var(--color-iron)] text-lg">
      Practical articles about designing, building, and shipping trade fair
      stands. No marketing fluff — concrete numbers.
    </p>
  </section>

  <section class="container-default mt-16 md:mt-24">
    {
      sorted.length === 0 ? (
        <p class="text-[var(--color-iron)]">Coming soon — first posts shortly.</p>
      ) : (
        <ul class="divide-y divide-[var(--color-iron)] list-none p-0">
          {sorted.map((post) => (
            <li class="py-8">
              <a
                href={localizedUrl(locale, `blog/${post.data.canonicalSlug}`)}
                class="block group"
              >
                <p class="font-mono text-xs uppercase tracking-widest text-[var(--color-iron)]">
                  {fmt.format(post.data.date)}
                </p>
                <h2 class="mt-3 text-[length:var(--text-h2)] leading-[var(--leading-h2)] font-semibold group-hover:text-[var(--color-rust)] transition-colors max-w-[24ch]">
                  {post.data.title}
                </h2>
                <p class="mt-3 text-[var(--color-iron)] max-w-[60ch]">
                  {post.data.description}
                </p>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
