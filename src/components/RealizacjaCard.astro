---
import { Image } from 'astro:assets';
import { localizedUrl, t } from '@i18n/utils';
import type { Locale } from '@i18n/routes';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'realizacje'>;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const { data } = entry;
const href = localizedUrl(locale, `realizacje/${data.canonicalSlug}`);
const clientLabel = data.clientPublic ? data.client : (locale === 'pl' ? 'Klient prywatny' : 'Private client');
---

<article class="group">
  <a href={href} class="block">
    <div class="relative aspect-[4/3] overflow-hidden bg-[var(--color-graphite)]">
      <Image
        src={data.cover}
        alt={data.title}
        widths={[400, 800, 1200]}
        sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
        class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
        loading="lazy"
      />
    </div>
    <div class="mt-4 grid grid-cols-[1fr_auto] gap-4 items-baseline">
      <h3 class="text-[length:var(--text-h3)] leading-[var(--leading-h2)] font-semibold">
        {data.title}
      </h3>
      <p class="font-mono text-xs text-[var(--color-iron)] tabular-nums">
        {data.year}
      </p>
    </div>
    <p class="mt-1 text-sm text-[var(--color-iron)]">
      {clientLabel} · {data.city} · {data.area_m2} m²
    </p>
  </a>
</article>
